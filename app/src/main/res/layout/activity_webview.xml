<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Khoảng trên cùng hiển thị ảnh biển số đã cắt ra để OCR, giúp đối chiếu khi thao tác trên web -->
    <ImageView
        android:id="@+id/imgPlate"
        android:layout_width="0dp"
        android:layout_height="84dp"
        android:scaleType="fitXY"
        android:background="#000000"
        android:contentDescription="Ảnh biển số"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <WebView
        android:id="@+id/webView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/imgPlate"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btnRegistryCheck"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:layout_marginStart="6dp"
        android:layout_marginTop="4dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="Check"
        android:textSize="13sp"
        android:background="@drawable/bg_floating_button"
        android:textColor="#FFFFFF"
        app:layout_constraintTop_toTopOf="@id/imgPlate"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/btnManageCredentials"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="6dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:text="🔑"
        android:textSize="13sp"
        android:background="@drawable/bg_floating_button"
        android:textColor="#FFFFFF"
        app:layout_constraintTop_toTopOf="@id/imgPlate"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btnPriceList"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="6dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:text="💲 Giá"
        android:textSize="13sp"
        android:background="@drawable/bg_floating_button"
        android:textColor="#FFFFFF"
        app:layout_constraintTop_toTopOf="@id/imgPlate"
        app:layout_constraintEnd_toStartOf="@id/btnManageCredentials" />

    <!-- Lớp phủ bảng giá, độ mờ giống các nút nổi, che toàn màn hình, ẩn theo mặc định -->
    <FrameLayout
        android:id="@+id/priceOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#CC000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Bảng giá theo loại xe"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnUploadPriceImage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:text="Up"
                    android:textSize="13sp"
                    android:background="#88000000"
                    android:textColor="#FFFFFF" />

                <Button
                    android:id="@+id/btnDeletePriceImage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:text="Xóa"
                    android:textSize="13sp"
                    android:background="#88000000"
                    android:textColor="#FFFFFF"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btnClosePriceList"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="10dp"
                    android:text="✕"
                    android:textSize="16sp"
                    android:background="#88000000"
                    android:textColor="#FFFFFF" />

            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <ScrollView
                    android:id="@+id/priceTableScrollView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <LinearLayout
                        android:id="@+id/priceTableContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                </ScrollView>

                <ImageView
                    android:id="@+id/imgCustomPriceTable"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:adjustViewBounds="false"
                    android:background="#000000"
                    android:contentDescription="Ảnh bảng giá đã up"
                    android:scaleType="fitXY"
                    android:visibility="gone" />

            </FrameLayout>

        </LinearLayout>

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
